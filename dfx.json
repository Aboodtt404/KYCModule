{
  "canisters": {
    "rust_backend": {
      "type": "rust",
      "package": "rust_backend",
      "candid": "rust_backend/rust_backend.did"
    },
    "sms_verification_backend": {
      "candid": "sms_verification/src/sms_verification_backend/sms_verification_backend.did",
      "package": "sms_verification_backend",
      "type": "rust"
    },
    "frontend": {
      "dependencies": [
        "rust_backend",
        "sms_verification_backend"
      ],
      "frontend": {
        "entrypoint": "frontend/dist/index.html"
      },
      "source": [
        "frontend/dist"
      ],
      "type": "assets"
    }
  },
  "output_env_file": ".env",
  "defaults": {
    "build": {
      "packtool": "mops sources"
    }
  },
  "workspace": {
    "sms_verification_backend": {
      "root": "sms_verification"
    },
    "rust_backend": {
      "root": "rust_backend"
    }
  }
}