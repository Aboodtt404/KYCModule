{
  "canisters": {
    "rust_backend": {
      "type": "rust",
      "package": "rust_backend",
      "candid": "rust_backend/rust_backend.did"
    },
    "sms_verification_backend": {
      "candid": "sms_verification/src/sms_verification_backend/sms_verification_backend.did",
      "package": "sms_verification_backend",
      "type": "rust"
    },
    "frontend": {
      "dependencies": [
        "rust_backend",
        "sms_verification_backend"
      ],
      "frontend": {
        "entrypoint": "frontend/dist/index.html"
      },
      "source": [
        "frontend/dist"
      ],
      "type": "assets"
    },
    "internet_identity": {
      "type": "custom",
      "candid": ".ii/internet_identity_latest.did",
      "wasm": ".ii/internet_identity_dev_latest.wasm.gz",
      "specified_id": "rdmx6-jaaaa-aaaaa-aaadq-cai",
      "remote": {
        "id": {
          "ic": "rdmx6-jaaaa-aaaaa-aaadq-cai"
        }
      }
    },
    "internet_identity_frontend": {
      "type": "custom",
      "candid": ".ii/internet_identity_frontend.did",
      "wasm": ".ii/internet_identity_frontend.wasm.gz"
    }
  },
  "output_env_file": ".env",
  "defaults": {
    "build": {
      "packtool": "mops sources"
    }
  },
  "networks": {
    "local": {
      "bind": "0.0.0.0:4943",
      "type": "persistent"
    }
  },
  "workspace": {
    "sms_verification_backend": {
      "root": "sms_verification"
    },
    "rust_backend": {
      "root": "rust_backend"
    }
  }
}