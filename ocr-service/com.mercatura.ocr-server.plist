<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd service for the KYC OCR server.

  INSTALL (once):
    cp ocr-service/com.mercatura.ocr-server.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.mercatura.ocr-server.plist

  START / STOP:
    launchctl start com.mercatura.ocr-server
    launchctl stop  com.mercatura.ocr-server

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.mercatura.ocr-server.plist
    rm ~/Library/LaunchAgents/com.mercatura.ocr-server.plist

  LOGS:
    tail -f /tmp/kyc-ocr-server.log
    tail -f /tmp/kyc-ocr-server.err
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mercatura.ocr-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/mfair/Desktop/KYC By Mercatura/ocr-service/start.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/mfair/Desktop/KYC By Mercatura/ocr-service</string>

  <!-- Start automatically at login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart automatically if it crashes -->
  <key>KeepAlive</key>
  <true/>

  <!-- Throttle rapid restarts to once per 10 seconds -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/kyc-ocr-server.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/kyc-ocr-server.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
